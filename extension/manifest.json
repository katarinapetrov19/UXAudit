{
  "manifest_version": 3,
  "name": "UXCheck",
  "version": "0.4.0",
  "author": "UXCheck Team",
  "homepage_url": "https://uxcheck.io",
  "description": "Instantly audit any website for UX and accessibility issues.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "report.js",
        "engine/contrast.js",
        "engine/headings.js",
        "engine/landmarks.js",
        "engine/aria.js",
        "engine/keyboard.js",
        "engine/heuristics.js",
        "engine/typography.js",
        "engine/hierarchy.js",
        "engine/responsive.js",
        "engine/visual.js",
        "content_script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine/*.js", "report.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
